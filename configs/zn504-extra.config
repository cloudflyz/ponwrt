# Local additions for ZNXT ZN504XG-D (cloudflyz)
# Merged after configs/an7581.config + configs/release.config.
# Keep this file small and rebase-friendly; do not edit upstream configs.

# Web terminal (handy while debugging PON bring-up over serial/SSH-less setups)
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# SQM (kmod-sched-cake is already pulled in by release.config)
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# Wake-on-LAN (luci-app-wol + etherwake backend)
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# Chinese UI for apps actually pulled in by release.config
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# Cloudflare Tunnel (cloudflared binary from the packages feed)
CONFIG_PACKAGE_luci-app-cloudflared=y
CONFIG_PACKAGE_luci-i18n-cloudflared-zh-cn=y
